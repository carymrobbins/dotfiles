[include]
	path = ~/.gitconfig.user

[user]
	useConfigOnly = true
[push]
	default = current
[pull]
	default = current
[merge]
	tool = kdiff3
[alias]
	c = clone-as
	co = checkout
	br = branch
	a = add
	au = add -u
	ap = add -p
	ci = commit
	cf = commit --fixup
	cpr = ! (echo -n "$(git rev-parse HEAD)" | xsel -ib) && xsel -ob && echo
        # Don't re-enable this, I always misuse this for ci -a
        # ca = commit --amend
	fu = commit --fixup
	sq = commit --squash
	fq = !git commit -a --fixup HEAD && git rebase -i --autosquash HEAD^^
	s = show
	ss = show --stat
	st = status
	d = diff
	dc = diff --cached
	dh = diff HEAD
	dni = diff --no-index
	l = log --oneline --color --no-decorate
	ln = log --oneline --color --no-decorate -n10
	ld = log --oneline --color --no-decorate develop..
	ll = log --graph --decorate
	ls = log --graph --decorate --stat
	l1 = log --oneline
	ll1 = log --graph --decorate --oneline
	lp = log -p
	f = fetch --all
	unstage = reset HEAD --
	r = rebase
	ari = !bash $HOME/dotfiles/shared/bin/git-auto-rebase
	ri = rebase -i --autosquash
	autosquash = rebase -i --autosquash
	p = push
	pt = push --follow-tags
	pf = push --force-with-lease
        rh = rebase-helper
        rho = rebase-helper origin/master
        size = count-objects -vH
        tt = !git tag | sort -V
[core]
	commentchar = "#"
	excludesfile = ~/.gitignore
	pager = less -F -X
[grep]
	lineNumber = true
[url "git://github.com/ghc/packages-"]
	insteadOf = git://github.com/ghc/packages/
[url "http://github.com/ghc/packages-"]
	insteadOf = http://github.com/ghc/packages/
[url "https://github.com/ghc/packages-"]
	insteadOf = https://github.com/ghc/packages/
[url "ssh://git\\@github.com/ghc/packages-"]
	insteadOf = ssh://git@github.com/ghc/packages/
[url "git\\@github.com:/ghc/packages-"]
	insteadOf = git@github.com:/ghc/packages/
