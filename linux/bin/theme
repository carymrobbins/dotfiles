#!/bin/bash

set -e

# TODO:
# lxappearance
# gitter
# intellij
# terminator

typ=$1

if [ "$typ" = "toggle" ]; then
  if grep dark ~/.theme-type >/dev/null; then
    typ=light
  else
    typ=dark
  fi
fi

dark_desktop=black-triangles.jpg
light_desktop=white-abstract.png

set_theme_type_file() {
  echo "$1" > ~/.theme-type
}

is_wsl() {
  if [[ "$(uname -r)" =~ WSL.$ ]]; then
    return 0
  else
    return 1
  fi
}

set_wallpaper() {
  (
    cd ~/dotfiles/linux/resources
    ./set-wallpaper "$1"
  )
}

# set_stalonetray_theme() {
#   (
#     cd ~/.xmonad
#     ln -s -f "stalonetrayrc.$1" stalonetrayrc
#   )
# }

#set_xmobar_theme() {
#  (
#    cd ~/.xmonad
#    ln -s -f "xmobarrc.$1" xmobarrc
#  )
#}

set_intellij_theme() {
  local jba_config_root="$HOME/.IntelliJIdea2018.1/config/jba_config"
  case "$1" in
    light)
      # Need an empty file
      echo > "$jba_config_root/colors.scheme.xml"
      # Set the theme
      cat <<'HERE' > "$jba_config_root/laf.xml"
<application>
  <component name="LafManager">
    <laf class-name="com.intellij.ide.ui.laf.IntelliJLaf" />
  </component>
</application>
HERE
      ;;
    dark)
      # Set the editor colors
      cat <<'HERE' > "$jba_config_root/colors.scheme.xml"
<application>
  <component name="EditorColorsManagerImpl">
    <global_color_scheme name="_@user_Darcula" />
  </component>
</application>
HERE
      # Set the theme
      cat <<'HERE' > "$jba_config_root/laf.xml"
<application>
  <component name="LafManager">
    <laf class-name="com.intellij.ide.ui.laf.darcula.DarculaLaf" />
  </component>
</application>
HERE
      ;;
  esac
}

switch_light_dark() {
  case "$1" in
    light) echo -n "$2";;
    dark) echo -n "$3";;
    *)
      >*2 echo "Invalid theme type: $1"
      exit 1
      ;;
  esac
}

set_batcat_config() {
  local batcat_config=$HOME/.config/bat/config
  if [ ! -f "$batcat_config" ]; then
    return
  fi
  local theme_name=$(switch_light_dark "$1" Coldark-Cold Coldark-Dark)
  sed -i \
    "s/^--theme=.*/--theme=\"$theme_name\"/" \
    "$batcat_config"
}

do_set_all() {
  set_theme_type_file "$1"
  set_batcat_config "$1"

  # TODO: Remove these
  # hexchat-theme         "$1"
  # set_intellij_theme   "$1"
  #
  # # dark -> dark_desktop, light -> light_desktop
  # wallpaper=$(eval 'echo $'$(echo "$(eval 'echo $1')_desktop"))
  # set_wallpaper "$wallpaper"
}

case "$typ" in
  dark|d)  do_set_all dark ;;
  light|l) do_set_all light ;;
  *)
    >&2 echo "Invalid theme type: $typ"
    exit 1
    ;;
esac

if ! is_wsl; then
  xmonad --restart
  #systemctl --user restart stalonetray
  reload-x-settings
  systemctl --user restart polybar
fi
